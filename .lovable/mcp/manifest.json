{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rawtotetuuorfqhmevpe.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "career-compass",
      "version": "0.1.0",
      "title": "Career Compass"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get my profile",
        "description": "Get the signed-in user's Readient profile: full name and role (student or recruiter).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_analyses",
        "title": "List resume analyses",
        "description": "List the signed-in student's saved resume readiness analyses, newest first, with id, field, target role and overall score.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "How many analyses to return (1-50)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_analysis",
        "title": "Get a resume analysis",
        "description": "Get the full result of one saved resume readiness analysis (pillar scores, ATS audit, roadmap, interview prep) by its id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The analysis id, as returned by list_analyses."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
